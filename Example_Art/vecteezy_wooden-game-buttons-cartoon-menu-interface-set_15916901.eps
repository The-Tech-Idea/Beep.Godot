   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Wooden game buttons, cartoon menu interface set</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Wooden game buttons, menu interface made of wood textured boards with ropes and vines. ui or gui graphic design elements. Isolated arrows, bars and keys for app user panel, Cartoon 2d vector icons set</rdf:li>
    </rdf:Alt>
   </dc:description>
