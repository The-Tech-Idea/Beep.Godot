[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://addons/beep_game_builder_cs/ecs/ui/kit/KitPushButton.cs" id="k_pbtn"]
[ext_resource type="Script" path="res://addons/beep_game_builder_cs/ecs/ui/ThemePresetComponent.cs" id="1_theme"]
[ext_resource type="Script" path="res://addons/beep_game_builder_cs/ecs/ui/GameInfoBinder.cs" id="2_binder"]
[ext_resource type="Script" path="res://addons/beep_game_builder_cs/ecs/scenes/strategy/Research.cs" id="3_script"]

[node name="Research" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_script")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.12, 0.15, 1)

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_top = 28
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Margin/VBox/Header"]
theme_type_variation = &"BeepTitle"
text = "Research Tree"
size_flags_horizontal = 3
vertical_alignment = 1

[node name="ScienceCaption" type="Label" parent="Margin/VBox/Header"]
theme_type_variation = &"BeepCaption"
text = "Science / turn"
vertical_alignment = 1

[node name="ScienceValue" type="Label" parent="Margin/VBox/Header"]
theme_type_variation = &"BeepValue"
text = "+18"
vertical_alignment = 1

[node name="BackButton" type="Button" parent="Margin/VBox/Header"]
custom_minimum_size = Vector2(120, 44)
text = "← Back"
script = ExtResource("k_pbtn")

[node name="HeaderRule" type="HSeparator" parent="Margin/VBox"]

[node name="TechGrid" type="HBoxContainer" parent="Margin/VBox"]
theme_override_constants/separation = 24
size_flags_vertical = 3

[node name="Tier1" type="VBoxContainer" parent="Margin/VBox/TechGrid"]
theme_override_constants/separation = 12
size_flags_horizontal = 3

[node name="Tier1Heading" type="Label" parent="Margin/VBox/TechGrid/Tier1"]
theme_type_variation = &"BeepSubtitle"
text = "Ancient Era"

[node name="Tech1" type="Button" parent="Margin/VBox/TechGrid/Tier1"]
custom_minimum_size = Vector2(0, 72)
text = "Iron Working"
script = ExtResource("k_pbtn")

[node name="Tech2" type="Button" parent="Margin/VBox/TechGrid/Tier1"]
custom_minimum_size = Vector2(0, 72)
text = "Horseback Riding"
script = ExtResource("k_pbtn")

[node name="Tier1Spacer" type="Control" parent="Margin/VBox/TechGrid/Tier1"]
size_flags_vertical = 3

[node name="Tier2" type="VBoxContainer" parent="Margin/VBox/TechGrid"]
theme_override_constants/separation = 12
size_flags_horizontal = 3

[node name="Tier2Heading" type="Label" parent="Margin/VBox/TechGrid/Tier2"]
theme_type_variation = &"BeepSubtitle"
text = "Classical Era"

[node name="Tech3" type="Button" parent="Margin/VBox/TechGrid/Tier2"]
custom_minimum_size = Vector2(0, 72)
text = "Engineering"
script = ExtResource("k_pbtn")

[node name="Tech4" type="Button" parent="Margin/VBox/TechGrid/Tier2"]
custom_minimum_size = Vector2(0, 72)
text = "Mathematics"
script = ExtResource("k_pbtn")

[node name="Tier2Spacer" type="Control" parent="Margin/VBox/TechGrid/Tier2"]
size_flags_vertical = 3

[node name="Tier3" type="VBoxContainer" parent="Margin/VBox/TechGrid"]
theme_override_constants/separation = 12
size_flags_horizontal = 3

[node name="Tier3Heading" type="Label" parent="Margin/VBox/TechGrid/Tier3"]
theme_type_variation = &"BeepSubtitle"
text = "Medieval Era"

[node name="Tier3Caption" type="Label" parent="Margin/VBox/TechGrid/Tier3"]
theme_type_variation = &"BeepCaption"
text = "Locked — research an earlier era first."
autowrap_mode = 3

[node name="Tier3Spacer" type="Control" parent="Margin/VBox/TechGrid/Tier3"]
size_flags_vertical = 3

[node name="Theme" type="Node" parent="."]
script = ExtResource("1_theme")
GenreName = "strategy"

[node name="GameInfoBinder" type="Node" parent="."]
script = ExtResource("2_binder")
TitleLabelPath = NodePath("Margin/VBox/Header/TitleLabel")
AppendGameName = true
ThemeComponentPath = NodePath("Theme")
