# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
/.vs/Beep.Godot.slnx/FileContentIndex

# .NET / C# build artifacts
[Bb]in/
[Oo]bj/
*.user
*.suo
/.vs/Beep.Godot/v18

# beep-mcp-server (Node)
tools/beep-mcp-server/node_modules/
tools/beep-mcp-server/dist/

# Probe / verification renders (tools/genre_shapes/KitProofProbe.cs writes here). These are
# regenerated by re-running the probe and are graded by verify_greyscale.py, not reviewed in
# the diff.
tmp/
!tmp/
tmp/*
!tmp/.gdignore

# Probe renders, capture logs and profiler traces. Same reasoning as tmp/ above: every file
# here is produced by re-running a probe and is graded by its probe, never read in a diff
# (178 MB and 439 files at the time this was added, including .nettrace CPU captures).
# The one exception is the APPROVED shoreline baseline, which is a reference artifact a probe
# compares against by SHA-256 - see plans/TERRAIN_VIEW_GRID_INTEGRATION.md.
tests/output/*
!tests/output/shoreline_approved/

# Python bytecode from the tools/ and plans/ scripts
__pycache__/
/.vs/Beep.Godot/CopilotIndices/18.8.1093.27292
/.vs/Beep.Godot.slnx/VSGitHubCopilot/ContextSpill/522b2a1ff75741cf9649c676428f5d8a/73d06f443f0d4616a0dd4a5698a5892a

# generated/ contains authored prefab artwork, scenes, manifests and import
# settings. Keep these versionable; only caches and temporary files are ignored.
