   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Game ui menu interface, scrolls and parchments</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Game ui menu interface, scrolls and antique parchments on blue wooden boards. Cartoon wood textured planks, gui graphic elements. User panel with settings, options or adventure isolated 2d vector set</rdf:li>
    </rdf:Alt>
   </dc:description>
