[ext_resource type="Script" path="res://addons/beep_game_builder_cs/ecs/scenes/citybuilder/Districts.cs" id="3_script"]

[node name="Districts" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_script")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.15, 0.15, 0.12, 1)

[node name="Margin" type="MarginContainer" parent="."]
