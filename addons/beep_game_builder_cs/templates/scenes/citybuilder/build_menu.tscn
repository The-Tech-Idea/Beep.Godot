[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Margin/VBox/Header"]
theme_type_variation = &"BeepTitle"
text = "Build"
size_flags_horizontal = 3
vertical_alignment = 1

[node name="BudgetCaption" type="Label" parent="Margin/VBox/Header"]
theme_type_variation = &"BeepCaption"
text = "Budget"
vertical_alignment = 1

[node name="BudgetValue" type="Label" parent="Margin/VBox/Header"]
