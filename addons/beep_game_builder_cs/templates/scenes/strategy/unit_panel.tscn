[ext_resource type="Script" path="res://addons/beep_game_builder_cs/ecs/scenes/strategy/UnitPanel.cs" id="3_script"]

[node name="UnitPanel" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
