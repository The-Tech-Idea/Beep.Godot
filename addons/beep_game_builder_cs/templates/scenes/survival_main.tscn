[ext_resource type="PackedScene" path="res://addons/beep_game_builder_cs/templates/scenes/levels/survival/level_2.tscn" id="lvl_2"]

[node name="SurvivalMain" type="Node2D"]

[node name="Atmosphere" parent="." instance=ExtResource("atmos_scene")]

[node name="LevelContainer" type="Node2D" parent="."]

[node name="LevelLoader" type="Node" parent="."]
script = ExtResource("10_loader")
Levels = Array[PackedScene]([ExtResource("lvl_1"), ExtResource("lvl_2")])
LevelContainerPath = NodePath("../LevelContainer")

[node name="Temperature" type="Node" parent="."]
script = ExtResource("5_temperature")

[node name="GameFlow" type="Node" parent="."]
script = ExtResource("1_flow")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="HUD"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Theme" type="Node" parent="HUD/Root"]
script = ExtResource("hud_theme")
GenreName = "survival"

[node name="WeatherForecast" type="Control" parent="HUD/Root"]
anchors_preset = 1
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 100
offset_right = -640
offset_bottom = -600
script = ExtResource("7_forecast")

[node name="Vitals" type="VBoxContainer" parent="HUD/Root"]
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -132.0
offset_right = 220.0
offset_bottom = -16.0
grow_vertical = 0
theme_override_constants/separation = 4

[node name="HealthLabel" type="Label" parent="HUD/Root/Vitals"]
text = "Health: 100 %"

[node name="HungerLabel" type="Label" parent="HUD/Root/Vitals"]
text = "Hunger: 75 %"

[node name="ThirstLabel" type="Label" parent="HUD/Root/Vitals"]
text = "Thirst: 80 %"

[node name="StaminaLabel" type="Label" parent="HUD/Root/Vitals"]
text = "Stamina: 100 %"

[node name="Minimap" type="Control" parent="HUD/Root"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -172.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 172.0
grow_horizontal = 0
script = ExtResource("minimap")
PlayerPath = NodePath("../../../Player")

[node name="CraftingScreen" type="Node" parent="."]
script = ExtResource("30_screen")
ScreenKey = "crafting"
OpenAction = "crafting"

[node name="InventoryScreen" type="Node" parent="."]
script = ExtResource("30_screen")
ScreenKey = "inventory"
OpenAction = "inventory"

[node name="MapScreen" type="Node" parent="."]
script = ExtResource("30_screen")
ScreenKey = "map"
OpenAction = "map"

[node name="GenreHud" type="Node" parent="HUD/Root"]
