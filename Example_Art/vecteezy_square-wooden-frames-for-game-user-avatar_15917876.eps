   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Square wooden frames for game user avatar</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Square wooden frames for game user avatar. Empty boards from brown wood with jungle vines and ropes, game buttons isolated on background, vector cartoon set</rdf:li>
    </rdf:Alt>
   </dc:description>
